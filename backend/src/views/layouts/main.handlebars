<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Agostina Pastelería</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="/css/styles.css">
</head>
<body>

    <!-- Navbar -->
    <nav class="navbar navbar-custom px-4 py-2">
        <a class="navbar-brand" href="/">🍰 Agostina Pastelería</a>
        <div>
            <a href="/products" class="me-3">Catálogo</a>
            <a href="/login">Admin</a>
        </div>
    </nav>

    <!-- Contenido de cada vista -->
    <main class="container my-5">
        {{{body}}}
    </main>

    <footer>
        <p class="mb-0">© 2024 Agostina Pastelería — Hecho con amor 🍰</p>
    </footer>

    <!-- Socket.io — actualizaciones en tiempo real -->
    <script src="/socket.io/socket.io.js"></script>
    <script>
        const socket = io();
        // Si el admin crea, edita o borra un producto desde el panel,
        // la vista se actualiza automáticamente sin recargar manualmente
        socket.on('product-created', () => location.reload());
        socket.on('product-updated', () => location.reload());
        socket.on('product-deleted', () => location.reload());
    </script>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>