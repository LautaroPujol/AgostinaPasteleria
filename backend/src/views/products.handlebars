<h2 class="mb-4" style="color: #004d55;">Nuestro Catálogo</h2>

<!-- Filtros -->
<div class="d-flex gap-2 mb-4 flex-wrap">
    <a href="/products?sort=asc" class="btn-pasteleria btn">Menor precio ↑</a>
    <a href="/products?sort=desc" class="btn-pasteleria btn">Mayor precio ↓</a>
    <a href="/products?query=tortas" class="btn-pasteleria btn">Tortas</a>
    <a href="/products?query=cheesecakes" class="btn-pasteleria btn">Cheesecakes</a>
    <a href="/products?query=cupcakes" class="btn-pasteleria btn">Cupcakes</a>
    <a href="/products" class="btn btn-outline-secondary">Ver todos</a>
</div>

<!-- Grid de productos -->
<div class="row">
    {{#each products}}
    <div class="col-12 col-md-6 col-xl-4 col-xxl-3 mb-4">
        <div class="card h-100">
            <img src="{{this.thumbnail}}" alt="{{this.title}}">
            <div class="card-body d-flex flex-column">
                <h5 class="card-title" style="color: #004d55;">{{this.title}}</h5>
                <p class="card-text text-muted small">{{this.description}}</p>
                <p class="precio">${{this.price}}</p>

                {{#if this.status}}
                    {{#if this.hasStock}}
                        <a href="/products/{{this.id}}" class="btn-pasteleria btn mt-auto">
                            Ver detalle
                        </a>
                    {{else}}
                        <button class="btn-pasteleria btn mt-auto" disabled>
                            Sin Stock 🚫
                        </button>
                    {{/if}}
                {{else}}
                    <button class="btn-pasteleria btn mt-auto" disabled>
                        No disponible
                    </button>
                {{/if}}
            </div>
        </div>
    </div>
    {{/each}}
</div>

<!-- Paginación -->
<div class="paginacion">
    {{#if hasPrevPage}}
        <a href="{{prevLink}}">← Anterior</a>
    {{/if}}

    <span>Página {{page}} de {{totalPages}}</span>

    {{#if hasNextPage}}
        <a href="{{nextLink}}">Siguiente →</a>
    {{/if}}
</div>