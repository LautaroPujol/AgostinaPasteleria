<div class="row align-items-center">
    <!-- Imagen del producto -->
    <div class="col-md-6 mb-4 mb-md-0">
        <img 
            src="{{product.thumbnail}}" 
            alt="{{product.title}}" 
            class="detalle-img"
            style="width:100%; max-height:400px; object-fit:cover; border-radius:12px;"
        >
    </div>

    <!-- Información del producto -->
    <div class="col-md-6">
        <div style="background:white; padding:2rem; border-radius:12px; box-shadow: 0 2px 8px rgba(0,0,0,0.1);">
            <h1 style="color:#004d55;">{{product.title}}</h1>

            <p class="text-muted mb-1">Categoría: <strong>{{product.category}}</strong></p>

            <p style="color:#004d55; font-size:1.8rem; font-weight:bold; margin:1rem 0;">
                ${{product.price}}
            </p>

            <p class="text-muted">{{product.description}}</p>

            {{#if product.hasStock}}
                <span class="badge bg-success" style="font-size:0.9rem; padding:0.5rem 1rem;">
                    ✅ Stock disponible: {{product.stock}} unidades
                </span>
            {{else}}
                <span class="badge bg-danger" style="font-size:0.9rem; padding:0.5rem 1rem;">
                    ❌ Sin stock
                </span>
            {{/if}}

            <hr>

            {{#if product.hasStock}}
                <form action="/carts/{{cartId}}/products/{{product.id}}" method="POST">
                    <button type="submit" class="btn-pasteleria btn w-100 mb-2">
                        🛒 Agregar al carrito
                    </button>
                </form>
            {{else}}
                <button class="btn-pasteleria btn w-100 mb-2" disabled>
                    Sin Stock 🚫
                </button>
            {{/if}}

            <a href="/products" class="btn btn-outline-secondary w-100">
                ← Volver al catálogo
            </a>
        </div>
    </div>
</div>
 